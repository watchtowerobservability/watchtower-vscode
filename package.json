{
  "name": "watchtower-vscode",
  "displayName": "Watchtower",
  "publisher": "watchtowerobservability",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watchtowerobservability/watchtower-vscode.git"
  },
  "description": "Watchtower issues, traces, replays and hot functions inside VS Code (TypeScript)",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "main": "./dist/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "watchtower.signIn",
        "title": "Watchtower: Sign in with API token"
      },
      {
        "command": "watchtower.signOut",
        "title": "Watchtower: Sign out"
      },
      {
        "command": "watchtower.refresh",
        "title": "Watchtower: Refresh issues and profiles"
      },
      {
        "command": "watchtower.openIssue",
        "title": "Watchtower: Open issue"
      },
      {
        "command": "watchtower.openTrace",
        "title": "Watchtower: Open trace"
      },
      {
        "command": "watchtower.openReplay",
        "title": "Watchtower: Open replay"
      },
      {
        "command": "watchtower.openLogs",
        "title": "Watchtower: Open logs in Logs explorer"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "watchtower.logs",
          "name": "Watchtower Logs"
        }
      ]
    },
    "configuration": {
      "title": "Watchtower",
      "properties": {
        "watchtower.apiUrl": {
          "type": "string",
          "default": "",
          "description": "Watchtower API base URL."
        },
        "watchtower.webUrl": {
          "type": "string",
          "default": "",
          "description": "Watchtower web app URL for links (defaults to the API URL)."
        },
        "watchtower.projectId": {
          "type": "string",
          "default": "",
          "description": "Project id."
        },
        "watchtower.service": {
          "type": "string",
          "default": "",
          "description": "Service whose profiles and logs drive hot-function and log CodeLens and the Logs view. Empty disables them."
        },
        "watchtower.maxIssues": {
          "type": "number",
          "default": 30,
          "description": "Unresolved issues to scan for stack frames."
        },
        "watchtower.hotThresholdPct": {
          "type": "number",
          "default": 5,
          "description": "Show a CodeLens for functions with at least this share of CPU."
        }
      }
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:vscode": "npm run build && node dist/test/runTest.js",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.15.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "mocha": "^10.8.2",
    "typescript": "5.7.2",
    "vitest": "5.0.5"
  }
}
